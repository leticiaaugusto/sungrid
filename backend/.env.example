# =====================================================================
# Variáveis de ambiente da API do SunGrid
# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env NUNCA deve ir para o GitHub (já está no .gitignore).
# =====================================================================

# Porta HTTP da API
PORTA=3000

# Endereço do frontend (liberado no CORS e usado no link de recuperação de senha)
URL_FRONTEND=http://localhost:5173

# Conexão com o PostgreSQL.
# Supabase: botão "Connect" > "Session pooler" (porta 5432).
DATABASE_URL=postgresql://postgres.SEU_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Use "true" para bancos na nuvem (Supabase) e "false" para PostgreSQL local
BANCO_SSL=true

# Segredo usado para assinar os tokens JWT (gere um texto longo e aleatório)
JWT_SEGREDO=troque-por-um-texto-longo-e-aleatorio
# Validade do token de login
JWT_EXPIRACAO=8h

# Validade do link de recuperação de senha, em minutos (RN05 / DP02)
TOKEN_RECUPERACAO_MINUTOS=30

# Domínios de e-mail aceitos no cadastro, separados por vírgula (RN04 / DP02).
# Deixe vazio para aceitar qualquer domínio.
DOMINIOS_PERMITIDOS=

# Envio de e-mail (Nodemailer). Se SMTP_HOST ficar vazio, o link de
# recuperação é apenas exibido no terminal da API (útil em desenvolvimento).
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE="SunGrid <nao-responda@sungrid.local>"

# Simulador de dados (loja 24h). Deixe "true" em APENAS UMA máquina do grupo,
# senão vários simuladores vão escrever no mesmo banco ao mesmo tempo.
SIMULADOR_ATIVO=true
# Intervalo da telemetria em segundos (padrão 5; faixa RNF07: 1 a 60).
SIMULADOR_TELEMETRIA_SEG=5
# Intervalo das leituras de histórico em minutos (padrão 15; 1 permite demonstração).
SIMULADOR_LEITURA_MIN=15
